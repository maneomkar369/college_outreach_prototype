# ── SendGrid (Free: 100 emails/day) ──────────────────────────────────────────
# Sign up: https://signup.sendgrid.com
# Get key: Settings → API Keys → Create API Key (Full Access)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=your-verified-email@gmail.com
SENDGRID_FROM_NAME=College Admissions

# ── Twilio Trial (Free $15.50 credit) ─────────────────────────────────────────
# Sign up: https://www.twilio.com/try-twilio
# Get from: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx   # your free Twilio trial number

# ── WhatsApp (PyWhatKit — Browser Automation) ─────────────────────────────────
# Setup: No API keys required. You just need to have your browser logged into 
# WhatsApp Web.
# Note: You don't need WHATSAPP_API_TOKEN or WHATSAPP_PHONE_NUMBER_ID anymore.

# ── Prototype Settings ────────────────────────────────────────────────────────
# Comma-separated verified numbers for SMS/Voice/WhatsApp (Twilio trial limit)
VERIFIED_TEST_NUMBERS=

# Your college info (used in message templates)
COLLEGE_NAME=Example College of Engineering
COLLEGE_PHONE=+91-XXXXXXXXXX
COLLEGE_WEBSITE=https://yourcollege.edu.in
ADMISSION_YEAR=2025-26
